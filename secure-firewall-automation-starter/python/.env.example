# Copy to python/.env and fill in. NEVER commit python/.env - it is gitignored.
# Use a dedicated, least-privilege FMC API user, not a shared admin account.

# --- Connection ---------------------------------------------------------------
# Must be https://. Plaintext http is rejected.
FMC_HOST=https://fmc.example.local
FMC_USERNAME=apiuser
# Leave blank here and export FMC_PASSWORD in your shell, or use a secrets manager.
FMC_PASSWORD=

# --- TLS ----------------------------------------------------------------------
# Certificate verification is ON by default. Keep it on.
VERIFY_SSL=true
# Preferred way to work with a self-signed / private-CA FMC: trust its CA instead of
# turning verification off. Absolute path to a PEM bundle.
# FMC_CA_BUNDLE=/absolute/path/to/fmc-ca.pem
#
# Last resort, LAB ONLY. This disables MITM protection for your API credentials:
# VERIFY_SSL=false

# --- Targets ------------------------------------------------------------------
# Leave blank to auto-discover the global domain.
FMC_DOMAIN_UUID=
ACCESS_POLICY_ID=
NAT_POLICY_ID=

# --- Inputs -------------------------------------------------------------------
OBJECTS_INPUT=inputs/objects.csv
SERVICES_INPUT=inputs/services.csv
RULES_INPUT=inputs/rules.csv
NAT_INPUT=inputs/nat.csv

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
