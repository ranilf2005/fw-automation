# Copy to .env and fill in. NEVER commit .env - it is gitignored.

# --- Workspaces ---------------------------------------------------------------
# Comma-separated name=path pairs. Only these directories can be addressed.
# When unset, the starter repo's terraform/ directory is used as "starter".
# TF_MCP_WORKSPACES=starter=/absolute/path/to/secure-firewall-automation-starter/terraform

# --- FMC credentials ----------------------------------------------------------
# Standard Terraform variable environment. Callers cannot set these.
TF_VAR_fmc_url=https://fmc.example.local
TF_VAR_fmc_username=apiuser
# Leave blank here and export TF_VAR_fmc_password in your shell.
TF_VAR_fmc_password=
# Lab only. Leaving this false keeps TLS certificate validation enabled.
TF_VAR_fmc_insecure_skip_verify=false

# --- Execution safety ---------------------------------------------------------
# The server can only init/validate/plan/show until this is true.
TF_MCP_ALLOW_APPLY=false
# Hard timeout per invocation, 10-3600 seconds.
TF_MCP_TIMEOUT=900

# Optional: absolute path to the terraform binary if it is not on PATH.
# TERRAFORM_BINARY=/usr/local/bin/terraform
# Optional: shared provider cache to avoid repeated downloads.
# TF_PLUGIN_CACHE_DIR=/var/cache/terraform-plugins

# --- Transport ----------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8002

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
