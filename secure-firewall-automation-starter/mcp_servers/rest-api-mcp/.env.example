# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# Use a dedicated, least-privilege FMC API user.

# --- Single FMC (env mode) ----------------------------------------------------
# Used when FMC_PROFILES_DIR is not set.
FMC_BASE_URL=https://fmc.example.local
FMC_USERNAME=apiuser
# Leave blank here and export FMC_PASSWORD in your shell, or use a secrets manager.
FMC_PASSWORD=
# Leave blank to auto-discover the global domain.
FMC_DOMAIN_UUID=

# --- Multiple FMCs (profile mode) ---------------------------------------------
# Point at a directory of *.env files, one per FMC. See profiles/.env.example.
# FMC_PROFILES_DIR=profiles
# FMC_PROFILE_DEFAULT=fmc-north-south

# --- TLS ----------------------------------------------------------------------
# Certificate verification is ON by default. Keep it on.
FMC_VERIFY_SSL=true
# Preferred way to work with a private CA: trust it rather than disabling checks.
# FMC_CA_BUNDLE=/absolute/path/to/fmc-ca.pem

# --- Write safety -------------------------------------------------------------
# The server is READ-ONLY until this is true. Enable only when you intend an agent
# to change firewall configuration, and only against a lab or non-production policy.
# Even then, apply_object_changes still requires a confirmation token from
# preview_object_changes.
FMC_ALLOW_WRITES=false

# --- Transport ----------------------------------------------------------------
# stdio (default) for desktop MCP clients, http for shared/Docker deployments.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Logs go to stderr; stdout is reserved for MCP.
LOG_LEVEL=INFO
