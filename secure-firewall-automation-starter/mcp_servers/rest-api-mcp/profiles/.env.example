# Copy to profiles/<name>.env, one file per FMC. NEVER commit a populated profile.
# The server auto-loads every *.env in FMC_PROFILES_DIR.

FMC_PROFILE_ID=fmc-north-south
FMC_PROFILE_DISPLAY_NAME=FMC North-South
# Comma-separated shortcuts an agent may use instead of the id.
FMC_PROFILE_ALIASES=north,north-south,dc1

FMC_BASE_URL=https://fmc-north.example.local
FMC_USERNAME=apiuser
FMC_PASSWORD=

# Certificate verification is ON by default.
FMC_VERIFY_SSL=true
# FMC_CA_BUNDLE=/absolute/path/to/fmc-ca.pem

# Optional: skip domain discovery.
FMC_DOMAIN_UUID=
