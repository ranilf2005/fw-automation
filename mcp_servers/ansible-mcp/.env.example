# Copy to .env and fill in. NEVER commit .env - it is gitignored.

# --- Where the playbooks live -------------------------------------------------
# Repository root containing ansible/playbooks/. Defaults to this starter repo.
# ANSIBLE_PROJECT_DIR=/absolute/path/to/fw-automation

# Optional: restrict further to a comma-separated list of playbook names (no .yml).
# When unset, every *.yml in ansible/playbooks/ is allowed.
# ANSIBLE_PLAYBOOK_ALLOWLIST=get_domain,get_network_objects,get_security_zones

# --- FMC credentials ----------------------------------------------------------
# Read by the playbooks via ansible/group_vars/all.yml. Callers cannot set these.
FMC_HOST=https://fmc.example.local
FMC_USERNAME=apiuser
# Leave blank here and export FMC_PASSWORD in your shell, or use ansible-vault.
FMC_PASSWORD=
FMC_DOMAIN_UUID=

# Certificate verification is ON by default.
VERIFY_SSL=true

# Optional, for ansible-vault encrypted variables.
# ANSIBLE_VAULT_PASSWORD_FILE=/absolute/path/to/vault-pass

# --- Execution safety ---------------------------------------------------------
# The server can only --syntax-check and --check (dry run) until this is true.
ANSIBLE_MCP_ALLOW_RUN=false
# Hard timeout per invocation, 10-3600 seconds.
ANSIBLE_MCP_TIMEOUT=600

# --- Transport ----------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
